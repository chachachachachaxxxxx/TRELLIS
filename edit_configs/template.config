# ============================================================
# TRELLIS composable 编辑配置模板
#
# 单次运行:
#   python run_edit_experiment.py --config edit_configs/template.config --dry-run
#   python run_edit_experiment.py --config edit_configs/template.config
#
# 批量评测:
#   python run_batch_edit_and_eval.py --config edit_configs/template.config --dry-run
#   python run_batch_edit_and_eval.py --config edit_configs/template.config
#
# 说明:
# - 单次运行使用顶层 `entrypoint` + `runtime` + `inputs` + `preprocess` + `ss` + `slat`
# - 批量评测额外读取 `batch`
# - `batch.input_templates` 会覆盖顶层 `inputs`，因此同一个文件可以同时作为单次模板和批量模板
# ============================================================

# Entrypoint 决定阶段组合和默认 preset。
# 速查：
#   - 想整条链都走 UniEdit：uniedit_full
#   - 想整条链都走 P2P + latent blend：p2p_latent_blend_full
#   - 已经有 SS 坐标，只补 SLAT：选 *_slat
#   - 只想先产出编辑后的体素坐标：选 *_ss
#   - 想 SS 更偏 P2P、SLAT 更偏 UniEdit：ss_p2p_slat_uniedit
#   - 想 SS 更偏 UniEdit、SLAT 更偏 P2P：ss_uniedit_slat_p2p
# 旧的 full-pipeline legacy 名称已经收口：
#   image_uniedit_rf_inversion -> uniedit_full
#   image_p2p_latent_blend -> p2p_latent_blend_full
# 可选值：
#   uniedit_full            = SS: UniEdit,            SLAT: UniEdit
#   uniedit_ss              = 仅运行 UniEdit SS
#   uniedit_slat            = 仅运行 UniEdit SLAT
#   p2p_latent_blend_full   = SS: P2P+blend,         SLAT: P2P+blend
#   p2p_latent_blend_ss     = 仅运行 P2P+blend SS
#   p2p_latent_blend_slat   = 仅运行 P2P+blend SLAT
#   ss_p2p_slat_uniedit     = SS: P2P+blend,         SLAT: UniEdit
#   ss_uniedit_slat_p2p     = SS: UniEdit,           SLAT: P2P+blend
entrypoint: p2p_latent_blend_full

runtime:
  # 输出目录下的 case 名；最终结果会落在 outputs/<entrypoint>/<case_name>/...
  case_name: edit_example
  # TRELLIS 模型或 Hugging Face repo id。
  model: microsoft/TRELLIS-image-large
  # 随机种子。
  seed: 1
  # 设备字符串，例如 cuda:0 / cuda:1 / cpu。
  device: cuda:0
  # 输出根目录。
  output_root: outputs
  # 采样条数。当前 composable 路径通常仍以 1 为主。
  num_samples: 1
  # 后端覆盖；留空表示走仓库默认。
  attn_backend: ""
  sparse_attn_backend: ""
  spconv_algo: native
  # 结果导出控制。
  skip_render: true
  skip_glb: false
  skip_ply: false
  # 如果 SLAT 插件支持，可额外导出 source 分支解码结果到 source_original/。
  save_source_outputs: false

inputs:
  # 2D 输入。所有 entrypoint 都至少需要 source_image 和 edit_image。
  source_image: assets/edit_example/images/2d_render.png
  edit_image: assets/edit_example/images/2d_edit.png
  # 当 preprocess.mask_policy=provided 时必填。
  mask_image: assets/edit_example/images/2d_mask.png
  # 需要 3D mask 的方法时必填，例如 p2p_latent_blend_* 或 uniedit_slat + latent_replace_union。
  mask_glb: assets/edit_example/mask.glb

  # 3D 输入：
  # - `*_ss` / `*_full` 需要 source_voxels
  # - `*_slat` / `*_full` 需要 source_features
  source_voxels: assets/edit_example/voxels.ply
  source_features: assets/edit_example/features.npz
  # 仅 slat-only 运行需要 edited_coords，通常来自前一次 SS 输出：
  # outputs/<ss_entrypoint>/<case_name>/edit/ss/coords.ply
  edited_coords: ""

preprocess:
  # crop_policy:
  # - disabled     不裁剪，直接走原图
  # - union_crop   以 source/edit/mask 的联合前景做裁剪，最常用
  # - mask_crop    更激进地围绕 mask 裁剪
  crop_policy: union_crop
  # foreground_policy:
  # - raw_rgb          原图 RGB
  # - alpha_only       只信输入 alpha
  # - alpha_or_rembg   alpha 不够时回退 rembg，当前默认最稳
  foreground_policy: alpha_or_rembg
  # mask_policy:
  # - provided   使用显式 mask_image
  # - auto_diff  通过 source/edit 差分自动生成
  # - blank      生成空白 mask
  mask_policy: provided
  mask_threshold: 128
  auto_mask_max_filter: 5
  auto_mask_diff_threshold: 24

ss:
  sampler:
    # 稀疏结构阶段采样步数；最常调的就是它。
    steps: 25
    # 如果不想覆盖 pipeline 默认值，写 null。
    cfg_strength: null
    rescale_t: null

  # 下方这组字段适用于：
  # - p2p_latent_blend_ss
  # - p2p_latent_blend_full
  # - ss_p2p_slat_uniedit
  inversion_mode: simple
  # true = 启用 latent blending；false = 只跑 P2P hook，不做 blend。
  blend_enabled: true
  blend_strength: 1.0
  hook:
    # P2P 注入起止时间与强度。
    t_start: 1.0
    t_end: 0.3
    strength: 1.0
  # token patch 覆盖阈值；通常保留 0.0 即可。
  patch_coverage_threshold: 0.0
  # 查询 chunk，显存不足时可适当减小。
  query_chunk: 1024
  # SS 去噪 / 反演 CFG。
  denoise_cfg_strength: 5.0
  denoise_cfg_interval: [0.5, 1.0]
  inversion_cfg_strength: 6.0
  inversion_cfg_interval: [0.5, 1.0]
  # coords 导出格式：ply / pt / both。
  output_format: both
  # 是否额外导出 voxel mesh 预览。
  save_voxel_mesh: true

  # 如果当前 entrypoint 的 SS 使用 UniEdit，而不是 P2P，请把上面的 P2P 专属字段删掉，
  # 换成下面这些字段：
  # omega: 1.0
  # cfg_interval: [0.5, 1.0]
  # output_format: both
  # save_voxel_mesh: true

slat:
  sampler:
    # SLAT 阶段采样步数。
    steps: 25
    cfg_strength: null
    rescale_t: null

  # 下方这组字段适用于：
  # - p2p_latent_blend_slat
  # - p2p_latent_blend_full
  # - ss_uniedit_slat_p2p
  inversion_mode: simple
  blend_enabled: true
  hook:
    t_start: 0.8
    t_end: 0.0
    strength: 1.0
  patch_coverage_threshold: 0.0
  query_chunk: 1024
  # true 时不额外解码 source 分支，省时间省显存。
  skip_source_decode: true

  # 如果当前 entrypoint 的 SLAT 使用 UniEdit，而不是 P2P，请把上面的 P2P 专属字段删掉，
  # 换成下面这些字段：
  # omega: 1.0
  # cfg_interval: [0.5, 1.0]
  # stage2_variant: preserve_uniedit
  # decode_modes: [gaussian, mesh]
  #
  # UniEdit 的 stage2_variant 可选：
  # - preserve_uniedit
  # - free_target
  # - latent_replace_union
  #
  # 注意：
  # - `uniedit_slat` / `uniedit_full` 在 `stage2_variant=latent_replace_union` 时，
  #   还要求 `inputs.source_voxels` + `inputs.mask_glb`

batch:
  # 本次批量实验的标识，会进入输出目录名。
  config_name: quick_test
  # Edit3D-Bench GT 根目录。
  gt_root: /home/wangxinxing/code/Edit3Dpp/data
  # 源 3D 资产根目录，通常包含 <dataset>/<object>/voxels.ply 和 features.npz。
  assets_root: /cache/wangxinxing/data/temp/renders
  # 评测输出根目录。批量脚本会在这里写 Edit3D-Bench 结构、临时 case config、评测结果。
  pred_root: /cache/wangxinxing/data/temp/composable_batch_template
  # 数据过滤项；留空表示不过滤。
  dataset: GSO
  object: Avengers_Gamma_Green_Smash_Fists
  prompt_id: 3
  max_cases: 1
  # 评测设备；为空时回退到 runtime.device。
  device: cuda:0
  metrics:
    - dino_if
    - clip_t
  # false = 先跑 Edit3D-Bench 的 render.py，再评测。
  skip_benchmark_render: false
  # true = 如果 pred_root 下已经有 edit.glb，就直接跳过该 case。
  skip_exists: false
  # true = 保留 _runs/<entrypoint>/<case>/ 下的完整单 case 输出，便于调试。
  # false = 复制 edit.glb 后删除单 case 输出，只保留评测所需结果。
  keep_case_outputs: false
  input_templates:
    # 这里的模板只给 run_batch_edit_and_eval.py 用，会覆盖顶层 inputs。
    source_image: "{gt_root}/{dataset}/{object_name}/prompt_{prompt_id}/2d_render.png"
    edit_image: "{gt_root}/{dataset}/{object_name}/prompt_{prompt_id}/2d_edit.png"
    mask_image: "{gt_root}/{dataset}/{object_name}/prompt_{prompt_id}/2d_mask.png"
    mask_glb: "{gt_root}/{dataset}/{object_name}/prompt_{prompt_id}/3d_edit_region.glb"
    source_voxels: "{assets_root}/{dataset}/{object_name}/voxels.ply"
    source_features: "{assets_root}/{dataset}/{object_name}/features.npz"
    # slat-only 批量任务才需要；full/ss 任务可保持空字符串。
    edited_coords: ""
