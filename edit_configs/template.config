# ============================================================
# TRELLIS composable 编辑配置模板
#
# 单次运行:
#   python run_edit_experiment.py --config edit_configs/template.config --dry-run
#   python run_edit_experiment.py --config edit_configs/template.config
#
# 批量评测:
#   python run_batch_edit_and_eval.py --config edit_configs/template.config --dry-run
#   python run_batch_edit_and_eval.py --config edit_configs/template.config
#
# 说明:
# - 单次运行使用顶层 `entrypoint` + `runtime` + `inputs` + `preprocess` + `ss` + `slat`
# - 批量评测额外读取 `batch`
# - `inputs` 是所有可能路径字段的并集；每个方法只填自己真正会用到的那部分
# ============================================================

# Entrypoint 只决定运行阶段，不再编码具体编辑方法组合。
# 可选值：
#   edit_full = SS + SLAT 全流程
#   edit_ss   = 仅运行 SS
#   edit_slat = 仅运行 SLAT
entrypoint: edit_full

runtime:
  # 输出目录下的 case 名；最终结果会落在 outputs/<entry_or_group>/<case_name>/...
  case_name: edit_example
  model: microsoft/TRELLIS-image-large
  seed: 1
  device: cuda:0
  output_root: outputs
  num_samples: 1
  attn_backend: ""
  sparse_attn_backend: ""
  spconv_algo: native
  skip_render: true
  skip_glb: false
  skip_ply: false
  save_source_outputs: false

inputs:
  # 2D 输入：
  # - edit_image 始终必填
  # - source_image / mask_image 是否必填取决于 preprocess 与 stage controls
  source_image: assets/edit_example/images/2d_render.png
  edit_image: assets/edit_example/images/2d_edit.png
  mask_image: assets/edit_example/images/2d_mask.png

  # 3D 输入：
  # - mask_glb: SS postprocess=restore_source_outside_mask / restore_all_outside_mask / boundary_band_restore，
  #             SLAT postprocess=restore_source_outside_mask，
  #             或 latent_blend / kv_blend 等路径需要
  # - source_voxels: SS 反演 / FlowEdit SS / AnchorFlow SS / SS postprocess / UniEdit SS 需要
  # - source_features: SLAT 反演 / SLAT latent_blend / SLAT postprocess / UniEdit SLAT 需要
  # - edited_coords: slat-only 运行时需要
  mask_glb: assets/edit_example/mask.glb
  source_voxels: assets/edit_example/voxels.ply
  source_features: assets/edit_example/features.npz
  edited_coords: ""

preprocess:
  # shared / voxhammer
  style: shared
  crop_policy: union_crop
  # provided / auto_diff / blank
  mask_policy: provided
  mask_threshold: 128
  auto_mask_max_filter: 5
  auto_mask_diff_threshold: 24
  adaptive_foreground_scale:
    # 默认关闭自适应，使用 fixed foreground crop scale = 1.2
    enabled: false
    strategy: global_linear
    probe_scales: [1.10, 1.35]
    min_scale: 1.0
    max_scale: 1.5
    min_bbox_volume_delta: 0.02
    fallback_scale: 1.2
    # 如需重新打开 adaptive，可继续使用下面这组 global_linear 参数：
    # cbrt(ss_bbox_volume_ratio) ~= intercept + slope * sqrt(proc_fg_bbox_area_ratio)
    linear_bbox_slope: 0.5449373200077813
    linear_bbox_intercept: 0.29052836699859885

ss:
  # controlled_denoise / uniedit / flowedit / anchorflow
  # 这里的 method 是 stage 主干；attention 注入仍看 controls.p2p.enabled。
  method: controlled_denoise

  sampler:
    steps: 25
    cfg_strength: null
    rescale_t: null

  inversion:
    # false 时必须配 random_noise；true 时当前实现要求 inverted_terminal_noise
    # inversion_steps: null 表示走完整个 sampler.steps；例如 sampler.steps=25, inversion_steps=15
    # 表示 source 只反演到第 15 个时间点，然后直接从该噪声点开始回到 t=0 去噪。
    enabled: true
    denoise_init: inverted_terminal_noise
    solver: simple
    refinement_steps: 0
    refinement_solver: inherit
    inversion_steps: null
    denoise_cfg_strength: 5.0
    denoise_cfg_interval: [0.5, 1.0]
    inversion_cfg_strength: 6.0
    inversion_cfg_interval: [0.5, 1.0]
    save_artifacts: false

  denoise:
    solver: inherit

  flowedit:
    n_avg: 5
    start_step: 12
    src_cfg_strength: 1.5
    tar_cfg_strength: 5.5
    cfg_interval: [0.0, 1.0]

  anchorflow:
    n_avg: 1
    n_max: 31
    src_cfg_strength: 3.5
    tar_cfg_strength: 5.0
    cfg_interval: [0.0, 1.0]
    center_weight: 0.10
    band_weight: 0.75
    ortho_weight: 0.20
    residual_weight: 0.05
    band_min_ratio: 0.60
    band_max_ratio: 1.40
    margin_scale: 0.80
    direction_gate_tau: 0.05
    eps: 1.0e-6
    anchor_noise: false

  controls:
    # p2p 可以和 latent_blend / uniedit 分别组合
    p2p:
      enabled: false
      t_start: 1.0
      t_end: 0.3
      strength: 1.0
      patch_coverage_threshold: 0.0

    # kv_blend 可以和 latent_blend 组合；当前不和 p2p / uniedit 混用
    kv_blend:
      enabled: false
      t_start: 1.0
      t_end: 0.0
      self_attention: true
      cross_attention: true
      # mask_only / preserve_complement
      # - mask_only: 仅把 3D mask 内看作 SS 可编辑域
      # - preserve_complement: 仅保护 source 的 preserve 区域，除此之外都允许修改
      edit_region_mode: mask_only
      soft_mask:
        enabled: false
        dilation: 2
        sigma: 1.0

    # latent_blend 可以和 p2p 组合；不能和 uniedit 同时开
    latent_blend:
      enabled: true
      strength: 1.0
      hard_mask_mode: edit_all
      # 需要和 kv_blend.edit_region_mode 保持一致
      edit_region_mode: mask_only
      soft_mask:
        enabled: false
        dilation: 2
        sigma: 1.0

    # uniedit 可以和 p2p 组合；不能和 latent_blend 同时开
    uniedit:
      enabled: false
      omega: 1.0
      cfg_interval: [0.5, 1.0]

  postprocess:
    # none / restore_source_outside_mask / restore_all_outside_mask / boundary_band_restore
    # 这里的 postprocess 语义与 ss.controls.*.edit_region_mode 无关。
    # - restore_source_outside_mask: 仅保留 source 的 mask 外体素
    # - restore_all_outside_mask: 保留 source 的 mask 外体素，并保留 raw 结果在 mask 外新增的体素
    mode: restore_all_outside_mask
    boundary_band:
      # 仅当 mode=boundary_band_restore 时生效。
      # mask 内部会先腐蚀出 core，保留 raw core；边界 band 则偏向保 source。
      band_width_voxels: 1
      # band 内 target voxel 需要至少这么多 6-neighbor 与 source shell / raw core 连通才保留。
      band_target_neighbor_threshold: 1

  output:
    output_format: both
    save_voxel_mesh: true

slat:
  # controlled_denoise / uniedit / direct_target
  # 这里的 method 是 stage 主干；attention 注入仍看 controls.p2p.enabled。
  method: controlled_denoise

  sampler:
    steps: 25
    cfg_strength: null
    rescale_t: null

  inversion:
    # false 时必须配 random_noise。
    # true 时可配 terminal_noise 或 random_noise：
    # - terminal_noise: 先反转 source SLAT，再把 terminal noise 投影到 edited coords 作为初始样本
    # - random_noise: 仍会生成 source inversion cache（供 latent/KV blend 用），但 denoise 从随机噪声开始
    # inversion_steps 语义同上；SLAT 会从该中间噪声状态直接开始 feature 去噪。
    enabled: true
    denoise_init: terminal_noise
    solver: simple
    refinement_steps: 0
    refinement_solver: inherit
    inversion_steps: null
    denoise_cfg_strength: null
    denoise_cfg_interval: null
    inversion_cfg_strength: null
    inversion_cfg_interval: null
    save_artifacts: false

  denoise:
    solver: inherit

  controls:
    p2p:
      enabled: false
      t_start: 0.8
      t_end: 0.0
      strength: 1.0
      patch_coverage_threshold: 0.0

    kv_blend:
      enabled: false
      t_start: 1.0
      t_end: 0.0
      self_attention: true
      cross_attention: true
      soft_mask:
        enabled: false
        dilation: 2
        sigma: 1.0

    latent_blend:
      enabled: true
      soft_mask:
        enabled: false
        dilation: 2
        sigma: 1.0

    # nano3d_replace: 仅在最终结果上把 mask 外且与 source 重合的
    # 坐标特征替换回 source SLAT。可和 SLAT inversion 一起用，也可单独用。
    nano3d_replace:
      enabled: false

    uniedit:
      enabled: false
      omega: 1.0
      cfg_interval: [0.5, 1.0]
      # preserve_uniedit / free_target
      stage2_variant: preserve_uniedit

  postprocess:
    # none / restore_source_outside_mask
    mode: none

  decode:
    skip_source_decode: true
    modes: [gaussian, mesh]

batch:
  config_name: template_batch
  # 例如: ablation / baseline / compare
  group: ""
  gt_root: /cache/wangxinxing/data/trellis_edit_benchmark/edit3d_data/data
  assets_root: /cache/wangxinxing/data/trellis_edit_benchmark/edit3d_data/renders
  pred_root: /cache/wangxinxing/data/trellis_edit_benchmark/pred/template_batch
  # 可选：显式指定一个问题子集，而不是按 metadata 全量枚举。
  # 支持：
  # selected_cases_file: edit_configs/case_sets/boundary_contact_full300_worst_union.yaml
  # selected_cases:
  #   - GSO/Dog/prompt_1
  #   - {dataset: GSO, object_name: Dog, prompt_id: 2}
  # selected_cases_file 和 selected_cases 会做并集并自动去重。
  selected_cases_file: ""
  selected_cases: []
  max_cases: 12
  metrics: [psnr, ssim, lpips, fid, dino_if_max, dino_if_mean, chamfer, clip_t]
  skip_benchmark_render: false
  skip_exists: false
  keep_case_outputs: false
  input_templates:
    source_image: "{gt_root}/{dataset}/{object_name}/prompt_{prompt_id}/2d_render.png"
    edit_image: "{gt_root}/{dataset}/{object_name}/prompt_{prompt_id}/2d_edit.png"
    mask_image: "{gt_root}/{dataset}/{object_name}/prompt_{prompt_id}/2d_mask.png"
    mask_glb: "{gt_root}/{dataset}/{object_name}/prompt_{prompt_id}/3d_edit_region.glb"
    source_voxels: "{assets_root}/{dataset}/{object_name}/voxels.ply"
    source_features: "{assets_root}/{dataset}/{object_name}/features.npz"
    edited_coords: ""
